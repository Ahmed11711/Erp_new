APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# ── Production (on server) ──────────────────────────────────────
# APP_ENV=production
# APP_DEBUG=false
# LOG_LEVEL=error
# CACHE_DRIVER=file
# QUEUE_CONNECTION=database
# SESSION_DRIVER=file
# ─────────────────────────────────────────────────────────────────
# للاستضافة مثل XAMPP مع مجلد public: APP_URL=http://test.mag-opt.com/backend/public
# → Webhook في Shopify (POST): http://test.mag-opt.com/backend/public/api/shopify/webhook
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Meta WhatsApp: صور قوالب الـ header يجب أن تُجلبها خوادم Meta من رابط HTTPS عام (ليس localhost).
# APP_URL: عنوان التطبيق (قد يكون http://localhost في التطوير).
# WHATSAPP_META_MEDIA_BASE_URL: إن كان APP_URL محلياً لكن الموقع يعمل على دومين عام، ضع نفس الدومين الـ HTTPS هنا لبناء روابط الصور.
# WHATSAPP_META_MEDIA_BASE_URL=https://your-domain.com
# APP_URL=https://your-domain.com

# Shopify — Webhook URL: {APP_URL}/api/shopify/webhook (Topic: orders/create)
# أنشئ مصدر طلب باسم Shopify في النظام وسجّل معرفه، وطريقة شحن افتراضية، وتصنيف احتياطي للسطور غير المربوطة.
# Admin API: Develop apps → Admin API access token
# - مزامنة المنتجات: read_products
# - مزامنة الطلبات: read_orders (+ read_all_orders إن لزم للطلبات الأقدم)
SHOPIFY_SHOP_DOMAIN=
# من Shopify: تطوير التطبيقات ← تطبيقك ← تكامل Admin API ← فعّل read_products و read_orders (وللطلبات القديمة read_all_orders) ثم انسخ Admin API access token بعد كل تغيير للصلاحيات
SHOPIFY_ADMIN_ACCESS_TOKEN=
# SHOPIFY_API_VERSION=2024-10
# SHOPIFY_HTTP_TIMEOUT=120
SHOPIFY_WEBHOOK_SECRET=
# SHOPIFY_ALLOWED_SHOP_DOMAINS=my-store.myshopify.com
SHOPIFY_DEFAULT_ORDER_SOURCE_ID=
SHOPIFY_DEFAULT_SHIPPING_METHOD_ID=
# معرف صنف (category) موجود فعلياً في categories.id — مطلوب لربط Shopify وإلا فشل FK
SHOPIFY_FALLBACK_CATEGORY_ID=
SHOPIFY_DEFAULT_GOVERNORATE=
# معرف مستخدم موجود في جدول users (لتسجيل خطوة التتبع عند إنشاء الطلب)
SHOPIFY_TRACKING_USER_ID=

# Webhooks في Shopify (نفس المسار لكل المواضيع): {APP_URL}/api/shopify/webhook
# orders/create, orders/updated, products/create, products/update, inventory_levels/update (اختياري)
# SHOPIFY_AUTO_IMPORT_ORDERS=true  — false = لا تُستورد الطلبات من webhook؛ المزامنة اليدوية فقط (قابل للتغيير من إعدادات Shopify)
# تصنيف طريقة الشحن تلقائياً: Small / Medium / Large — راجع config/shopify_shipping_tiers.php
# SHOPIFY_SHIPPING_METHOD_SMALL=Small
# SHOPIFY_SHIPPING_METHOD_MEDIUM=Medium
# SHOPIFY_SHIPPING_METHOD_LARGE=Large

# شركة الشحن الخارجية — إرسال الطلب بعد الاستيراد: POST {SHIPPING_API_BASE_URL}/orders
SHIPPING_API_BASE_URL=
SHIPPING_API_TOKEN=
# SHIPPING_API_TIMEOUT=60
# رد شركة الشحن على ERP: POST {APP_URL}/api/webhooks/shipping/update
# Authorization: Bearer {SHIPPING_WEBHOOK_SECRET} أو ترويسة X-Shipping-Webhook-Secret
SHIPPING_WEBHOOK_SECRET=